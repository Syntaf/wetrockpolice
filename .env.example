# Server configuration
# ------------------------------------
PORT=3001
MOCK_WEATHER_DATA=true

# Weather configuration (Optional)
# ------------------------------------
# Synoptic API token for the server-side precipitation proxy
# (GET /:slug/precipitation). Not needed in development while
# MOCK_WEATHER_DATA=true serves the bundled fixture instead.
SYNOPTIC_API_TOKEN=
# CampbellCloud login for alternate rain gauges (GET /:slug/precipitation/:gauge),
# e.g. SNCC's Black Velvet gauge. CampbellCloud has no API keys, so use a
# dedicated read-only CampbellCloud user, never a personal login.
# Organization id below is DRI's (owner of the Black Velvet station).
CAMPBELL_CLOUD_ORGANIZATION_ID=4b170721-0e5f-4158-bbdc-3d9d0f4ab2f4
CAMPBELL_CLOUD_USERNAME=
CAMPBELL_CLOUD_PASSWORD=
# Optional; defaults to us-west-2.campbell-cloud.com
CAMPBELL_CLOUD_HOST=

# Database configuration
# ------------------------------------
POSTGRES_DB=wetrockpolice_development
POSTGRES_USER=wrp
POSTGRES_HOST=0.0.0.0
POSTGRES_PASSWORD=dev
POSTGRES_TEST_DB=wetrockpolice_test

# Email configuration (Optional)
# ------------------------------------
SENDGRID_PASSWORD=
SENDGRID_DOMAIN=
