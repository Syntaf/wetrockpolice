# Server configuration
# ------------------------------------
PORT=3001
MOCK_WEATHER_DATA=true

# Weather configuration (Optional)
# ------------------------------------
# Synoptic API token for the server-side precipitation proxy
# (GET /:slug/precipitation). Not needed in development while
# MOCK_WEATHER_DATA=true serves the bundled fixture instead.
SYNOPTIC_API_TOKEN=

# Database configuration
# ------------------------------------
POSTGRES_DB=wetrockpolice_development
POSTGRES_USER=wrp
POSTGRES_HOST=0.0.0.0
POSTGRES_PASSWORD=dev
POSTGRES_TEST_DB=wetrockpolice_test

# Email configuration (Optional)
# ------------------------------------
SENDGRID_PASSWORD=
SENDGRID_DOMAIN=
