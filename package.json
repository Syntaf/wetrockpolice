{
  "name": "wetrockpolice",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.4",
    "date-fns": "^4.1.0",
    "esbuild": "^0.25.0",
    "rails_admin": "3.3.0",
    "sass": "1.77.8"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js app/javascript/rails_admin.js --bundle --sourcemap --minify --format=esm --splitting --chunk-names=[name]-[hash].digested --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css ./app/assets/stylesheets/rails_admin.scss:./app/assets/builds/rails_admin.css --no-source-map --load-path=node_modules --quiet-deps --style=compressed"
  },
  "engines": {
    "node": "20.x"
  }
}
