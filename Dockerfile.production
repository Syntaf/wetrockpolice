# Development environment
FROM ruby:3.3.12

ENV RAILS_ENV=production
ENV INSTALL_PATH /opt/wetrockpolice
RUN mkdir -p $INSTALL_PATH

# nodejs, yarn & bun
RUN curl -sL https://deb.nodesource.com/setup_20.x | bash - 
# apt-key is gone from current Debian (ruby:3.3+ images), so yarn comes from
# npm rather than the dl.yarnpkg.com apt repo.
RUN apt-get update && apt-get install -y --no-install-recommends nodejs python3 python-is-python3 && \
    npm install -g yarn

# set working directory
WORKDIR /opt/wetrockpolice

# instally ruby gems
COPY Gemfile Gemfile.lock .ruby-version ./
RUN gem install bundler
RUN bundle install --jobs 1

# install node modules
COPY package.json yarn.lock ./
RUN yarn install --check-files

COPY . .

RUN SECRET_KEY_BASE=dummy RAILS_ENV=production rails assets:precompile

EXPOSE 3001
CMD ["bundle", "exec", "rails", "server", "-p", "3001", "-b", "0.0.0.0"]
