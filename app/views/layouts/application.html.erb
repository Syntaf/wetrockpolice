<!DOCTYPE html>
<html>
  <head>
    <%= display_meta_tags site: "Wetrockpolice" %>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:400,600|Noto+Sans:400,600|Raleway:500,600,800">

    <%= stylesheet_link_tag 'application' %>
    <%# type="module": the esbuild bundle is built with --format=esm
        --splitting so the dev-only weather fixture loads as a separate
        chunk; module scripts are deferred by default. %>
    <%= javascript_include_tag 'application', type: 'module' %>

    <%= render partial: 'shared/analytics' %>

    <!-- Star wetrockpolice on github! -->
    <script async defer src="https://buttons.github.io/buttons.js"></script>
  </head>

  <body 
    data-page-controller="<%= controller_name %>"
    <%= yield :body_attributes %>>
    <!-- Content -->
    <%= yield %>
    <!-- Footer -->
    <div class="footer">
      <div class="footer-container d-flex flex-column flex-md-row">
        <div class="d-flex flex-column flex-md-row px-2 mb-3 mb-md-0">
          <div class="text-center me-md-3">
            <%= image_tag 'logo.png',
              style: 'max-width: 50px; width: 100%; height: auto;' %>
          </div>
          <div>
            <p>Made with <i class="bi bi-heart-fill"></i> by </p>
            <a href="mailto:gmercer015@gmail.com">grant@wetrockpolice.com</a>
            <p>& contributions from <a href="https://github.com/Alizon121">andrew</a></p>
          </div>
        </div>
        <div class="d-flex flex-row flex-md-column justify-content-center align-items-center px-2 mb-2 mb-md-0">
          <a class="github-button contribute-button"
            href="https://github.com/syntaf/wetrockpolice/fork"
            data-icon="octicon-repo-forked"
            data-size="large"
            aria-label="Fork syntaf/wetrockpolice on GitHub">
            Contribute
          </a>
          <a class="github-button star-button"
            href="https://github.com/syntaf/wetrockpolice"
            data-icon="octicon-star"
            data-size="large"
            data-show-count="true"
            aria-label="Star syntaf/wetrockpolice on GitHub">
            Star
          </a>
        </div>
        <div class="d-flex justify-content-center flex-column flex-md-row align-items-center px-2 pb-3 pb-md-0">
          <div class="mb-2 mb-md-0">
            <p>
              Check out my other project
            </p>
            <a class="elink"
              target="_blank"
              href="https://embolt.app/?utm_source=v1&utm_medium=referral&utm_campaign=wetrockpolice">
              embolt.app
            </a>
          </div>
          <%= image_tag(
            'embolt-icon.svg',
            class: 'embolt-icon ms-md-3'
          ) %>
        </div>
      </div>
    </div>
  </body>
</html>
